# 复制为项目根目录 .env；真实密钥不要提交到版本控制。
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RAG_LLM_MODEL=qwen-plus

# 本地 BGE 模型要求 CLS pooling、512 维；模型准备方式见 README。
RAG_EMBEDDING_MODEL=./data/models/bge-small-zh-v1.5
RAG_RERANKER_MODEL=BAAI/bge-reranker-base
RAG_DEVICE=cpu
RAG_MAX_UPLOAD_MB=20
RAG_DATA_DIR=./data/knowledge

# 相对路径按启动工作目录解析，请从项目根目录启动。
# BAILIAN_BASE_URL / BAILIAN_MODEL 不是当前代码读取的变量名。
